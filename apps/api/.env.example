PORT=4000
APP_SEARCH_MODE=mock
APP_DATA_SCOPE=published
# Pilot: NODE_ENV=development + APP_DATA_SCOPE=local_pilot + mode lexical.
# Jangan aktifkan scope pilot di production. Izin publikasi belum tuntas.
DATABASE_URL=
DB_POOL_MAX=3
DB_TIMEOUT_MS=5000
TEST_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Simpan URL Neon hanya di .env yang diabaikan Git.
# Gunakan branch development/test khusus; mock tidak mengakses database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# LLM foundation is disabled by default and is not connected to an endpoint.
# Set cloudflare only for explicit adapter/live-contract testing.
AI_LLM_PROVIDER=disabled
AI_LLM_MODEL=
AI_LLM_TIMEOUT_MS=30000
AI_LLM_MAX_CONCURRENCY=2
# Internal retrieval tools are server-bounded and are not public endpoints.
RETRIEVAL_TIMEOUT_MS=10000
RETRIEVAL_MAX_OUTPUT_BYTES=262144
ORCHESTRATION_MAX_CONTEXT_CHARS=16000
ORCHESTRATION_MAX_OUTPUT_BYTES=65536
ORCHESTRATION_MAX_TOOL_EXECUTIONS=4
ORCHESTRATION_MAX_OUTPUT_TOKENS=512
# Internal API v2 remains fail-closed. Enable only in development/test and use a
# backend-only random ASCII key of at least 32 characters. Never use NEXT_PUBLIC_*.
INTERNAL_CONVERSATION_API_ENABLED=false
INTERNAL_CONVERSATION_API_KEY=
CONVERSATION_API_TIMEOUT_MS=45000
CONVERSATION_API_MAX_CONCURRENCY=2
CONVERSATION_SSE_MAX_OUTPUT_BYTES=262144
# Live test is a separate approval-gated synthetic probe. It never runs as part
# of npm test. Keep RUN/approval values at 0 until model, privacy, quota/cost,
# credentials, and inference approval have been reviewed. Research-only evidence
# is forbidden.
RUN_LIVE_CLOUDFLARE_LLM=0
AI_LLM_LIVE_INFERENCE_APPROVED=0
AI_LLM_LIVE_PRIVACY_APPROVED=0
AI_LLM_LIVE_QUOTA_APPROVED=0
AI_LLM_LIVE_DATA_SCOPE=synthetic_only
AI_LLM_LIVE_MAX_REQUESTS=1
AI_LLM_LIVE_MAX_TOKENS=16
AI_LLM_LIVE_TOKEN_BUDGET=16
