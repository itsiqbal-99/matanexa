{
  "name": "@matanexa/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run build && node --test test/*.test.cjs",
    "db:check": "node dist/database/cli.js check",
    "db:audit": "node dist/database/cli.js audit",
    "db:migrate": "node dist/database/cli.js migrate",
    "db:import": "node dist/database/cli.js import",
    "test:db": "npm run build && node --test test/*.integration.cjs",
    "search:evaluate": "node dist/modules/search/evaluation/cli.js",
    "pilot:download": "node dist/database/pilot.cli.js download",
    "pilot:prepare": "node dist/database/pilot.cli.js prepare",
    "pilot:import": "node dist/database/pilot.cli.js import",
    "pilot:index": "node dist/database/index-embeddings.cli.js",
    "pilot:evaluate": "node dist/modules/search/evaluation/pilot.cli.js",
    "pilot:reindex": "node dist/database/pilot.cli.js reindex"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "dotenv": "^17.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "^5.0.0",
    "@types/pg": "8.23.1"
  }
}
