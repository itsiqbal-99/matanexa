PORT=4000
APP_SEARCH_MODE=mock
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for lexical/hybrid only. Copy to backend .env; NEVER commit credentials.
DATABASE_URL=
# Required for hybrid only; NestJS uses Cloudflare REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
